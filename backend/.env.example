# 相对 SQLite 路径相对于 backend/instance，默认无需修改。
DATABASE_URL=sqlite:///paperflow.db
# 推荐在网站顶部“AI 设置”中接入，保存后立即生效，无需编辑此文件。
# 下列值仅作为尚未网页保存时的初始配置；网页配置优先。不要提交真实密钥。
AI_ENABLED=false
AI_API_KEY=
# Chat Completions 兼容服务的基础地址（不要包含 /chat/completions）。
AI_BASE_URL=https://api.openai.com/v1
# 填写服务商提供且账户可访问的模型名称。
AI_MODEL=
# 1～60 秒；输出上限 256～8000 tokens。
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=3000
# 某些兼容服务只支持 max_tokens，可按服务商文档修改。
AI_TOKEN_PARAMETER=max_completion_tokens
